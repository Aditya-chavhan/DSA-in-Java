//Que Link:https://www.geeksforgeeks.org/problems/smallest-and-largest/1

class Solution {
    public ArrayList<String> smallerAndLarge(String str) {
        ArrayList<String>ans=new ArrayList<>();
        String[]word=str.split("\\s+");
        
        String smallest=word[0];
        String largest=word[0];
        
        for(int i=0;i<word.length;i++){
            if(word[i].length()<smallest.length()){
                smallest=word[i];
            }
        }
        
        for(int i=0;i<word.length;i++){
            if(word[i].length()>=largest.length()){
                largest=word[i];
            }
        }
        
        ans.add(smallest);
        ans.add(largest);
        
        return ans;
        
    }
}
