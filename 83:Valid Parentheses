//Que Link:https://leetcode.com/problems/valid-parentheses/description/

class Solution {
    public boolean isValid(String s) {
        Stack<Character>st=new Stack<>();
        for(int i=0;i<s.length();i++){
            char currChar=s.charAt(i);
            if(currChar=='(' || currChar=='[' || currChar=='{'){
                st.push(currChar);
            }
            else{
                if(st.isEmpty()) return false;//first char is closing bracket
                char top=st.peek();
                if(closing(top,currChar)==true){
                    st.pop();
                }
                else{
                    return false;
                }
            }
        }
        return(st.isEmpty());
    }
    public static boolean closing(char top,char currChar){
            if(top=='(' && currChar==')') return true;
            if(top=='[' && currChar==']') return true;
            if(top=='{' && currChar=='}') return true;
            return false;
    }
}
