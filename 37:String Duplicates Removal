//Que Link:https://www.geeksforgeeks.org/problems/remove-all-duplicates-from-a-given-string4321/1

class Solution {
    String removeDuplicates(String s) {
        StringBuilder sb=new StringBuilder();
        HashSet<Character>set=new HashSet<>();
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(!set.contains(ch)){
                set.add(ch);
                sb.append(ch);
            }
        }
        String ans=sb.toString();
        return ans;
    }
}
