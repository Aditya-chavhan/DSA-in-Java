//Que Link:https://leetcode.com/problems/next-greater-element-i/description/

class Solution {
    public int[] nextGreaterElement(int[] arr1, int[] arr2) {
        int[]ans=new int[arr1.length];
        Arrays.fill(ans,-1);

        for(int i=0;i<arr1.length;i++){
            int curr=arr1[i];

            for(int j=0;j<arr2.length;j++){
                if(curr==arr2[j]){

                    for(int k=j+1;k<arr2.length;k++){
                        if(arr2[k]>curr){
                            ans[i]=arr2[k];
                            break;
                        }
                    }
                    
                }
            }

        }
        return ans;
    }
}
