//Que Link:https://leetcode.com/problems/maximum-subarray/description/

class Solution {
    public int maxSubArray(int[] arr) {
        int maxSum=Integer.MIN_VALUE;
        int sum=0;
        for(int i=0;i<arr.length;i++){
            sum=sum+arr[i];
            maxSum=Math.max(sum,maxSum);
            if(sum<0){
                sum=0;
            }
        }
        return maxSum;
    }
}
