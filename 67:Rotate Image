//Que Link:https://leetcode.com/problems/rotate-image/description/   (CLOCKWISE)

class Solution {
    public void rotate(int[][] arr) {
        int m=arr.length;//rows
        int n=arr[0].length;//column

        //Step 1:Transpose matrix
        for(int i=0;i<m;i++){
            for(int j=0;j<i;j++){
                int temp=arr[i][j];
                arr[i][j]=arr[j][i];
                arr[j][i]=temp;
            }
        }

        //step 2:Reverse rows
        for(int row=0;row<m;row++){
            int i=0;
            int j=m-1;
            while(i<j){
                int temp=arr[row][i];
                arr[row][i]=arr[row][j];
                arr[row][j]=temp;
                i++;
                j--;
            }
        }
    }
}

