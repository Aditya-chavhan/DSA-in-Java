//Que Link:https://www.geeksforgeeks.org/problems/gcd-of-two-numbers3459/1

class Solution {
    public static int gcd(int a, int b) {
        return helper(Math.min(a,b),Math.max(a,b));
    }
    public static int helper(int a,int b){
        if(a==0){
            return b;
        }
        return helper(b%a,a);
    }
}
