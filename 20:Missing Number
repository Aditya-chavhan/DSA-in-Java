//Que Link:https://leetcode.com/problems/missing-number/description/

class Solution {
    public int missingNumber(int[] arr) {
        int n=arr.length;
        int sum=0;
        for(int i=0;i<arr.length;i++){
            sum=sum+arr[i];
        }

        int totalSum=n*(n+1)/2;
        return totalSum-sum;
    }
}
