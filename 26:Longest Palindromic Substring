//Que Link:https://leetcode.com/problems/longest-palindromic-substring/description/

class Solution {
    public String longestPalindrome(String str) {
        String ans="";    
        for(int i=0;i<str.length();i++){
            for(int j=i;j<str.length();j++){
               if(isPalindrome(i,j,str)==true){
                int len=j-i+1;
                if(len>ans.length()){
                  ans=str.substring(i,j+1);
                }
               }
            }
        }
        return ans;
    }
    public static boolean isPalindrome(int i,int j,String str){
        while(i<j){
            if(str.charAt(i)!=str.charAt(j)){
                return false;
            }
            i++;
            j--;
        }
        return true;
    }
}
