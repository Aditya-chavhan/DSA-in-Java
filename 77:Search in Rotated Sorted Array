//Que Link:https://leetcode.com/problems/search-in-rotated-sorted-array/submissions/1714642418/

class Solution {
    public int search(int[] arr, int target) {
       int n=arr.length;
        int beg=0;
        int end=n-1;
        while(beg<=end){
            int mid=(beg+end)/2;
            if(arr[mid]==target){
                return mid;
            }
            else if(arr[mid]>=arr[beg]){
                if(arr[beg]<=target && target<arr[mid]){
                    end=mid-1;
                }
                else{
                    beg=mid+1;
                }
            }
            else{
                if(arr[mid]<target && target<=arr[end]){
                    beg=mid+1;
                }
                else{
                    end=mid-1;
                }
            }
        }
        return -1; 
    }
}
