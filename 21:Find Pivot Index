//Que Link:https://leetcode.com/problems/find-pivot-index/description/

class Solution {
    public int pivotIndex(int[] arr) {
        int pivIdx=-1;
        for(int i=0;i<arr.length;i++){
            int curr=i;

            int leftSum=0;
            int rightSum=0;

            for(int j=0;j<curr;j++){
               leftSum=leftSum+arr[j];
            }

            for(int k=curr+1;k<arr.length;k++){
                rightSum=rightSum+arr[k];
            }

            if(leftSum==rightSum){
               pivIdx=curr;
               break;
            }

        }
        return pivIdx;
    }
}
