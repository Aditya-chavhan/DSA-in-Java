//Que Link:https://www.geeksforgeeks.org/problems/remove-vowels-from-string1446/1

class Solution {
    String removeVowels(String s) {
        s=s.toLowerCase();
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch=='a'|| ch=='e'||ch=='i'||ch=='o'||ch=='u'){
                continue;
            }
            else{
               sb.append(ch); 
            }
        }
        String ans=sb.toString();
        return ans;
    }
}
