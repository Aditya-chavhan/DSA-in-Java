//Que Link:https://leetcode.com/problems/reverse-integer/description/

class Solution {
    public int reverse(int num) {
        long ans=0;
        while(num!=0){
            int digit=num%10;
            ans=ans*10+digit;
            num=num/10;
        }

        if(ans>Integer.MAX_VALUE || ans<Integer.MIN_VALUE){
            return 0;
        }
        
      return (int)ans;
    }
}
