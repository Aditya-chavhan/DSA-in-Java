//Que Link:https://leetcode.com/problems/search-insert-position/description/

class Solution {
    public int searchInsert(int[] arr, int target) {
        if(arr.length==1 && arr[0]>target){
           return 0;
        }
        for(int i=0;i<arr.length;i++){
            if(arr[i]==target){
               return i;
            }
            else{
                if(i+1<arr.length && arr[i]<target && arr[i+1]>target){
                    return i+1;
                }
                if(i+1<arr.length && arr[i]>target && arr[i+1]>target){
                    return i;
                }
            }
        }
        return arr.length;
    }
}
