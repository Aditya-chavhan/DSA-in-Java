//Que Link:https://leetcode.com/problems/find-peak-element/description/

class Solution {
    public int findPeakElement(int[] arr) {   
        if (arr.length == 1 || arr[0] > arr[1]) {
            return 0;
        }

        for(int i=1;i<arr.length-1;i++){
            if(arr[i-1] < arr[i] && arr[i+1] < arr[i]){
                return i;
            } 
        }

        return arr.length-1;
    }
}

-----------------------------------------------------------OR-------------------------------------------------------------


class Solution {
    public int findPeakElement(int[] arr) {   
        for(int i=0;i<arr.length;i++){
           int peak=arr[i];
           boolean Lflag=true;
           boolean Rflag=true;
           for(int j=0;j<i;j++){
              if(arr[j]>peak){
                Lflag=false;
                break;
              }
           }

           for(int k=i+1;k<arr.length;k++){
            if(arr[k]>peak){
                Rflag=false;
                break;
            }
           }

           if(Lflag==true && Rflag==true){
             return i;
           }
        }
        return 0;
    }
}
