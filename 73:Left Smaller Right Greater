//GFG que:https://www.geeksforgeeks.org/problems/unsorted-array4925/1

class Solution {
    public int findElement(int[] arr) {

        for (int i = 1; i < arr.length - 1; i++) {

            boolean flag = true;

            for (int j = 0; j < i; j++) {
                if (arr[j] > arr[i]) {
                    flag = false;
                    break;
                }
            }

            for (int j = i + 1; j < arr.length && flag==true; j++) {
                if (arr[j] < arr[i]) {
                    flag = false;
                    break;
                }
            }

            if (flag==true) {
                return arr[i];
            }
        }

        return -1;
    }
}
