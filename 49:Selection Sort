//Que Link:https://www.geeksforgeeks.org/problems/selection-sort/1

class Solution {
    void selectionSort(int[] arr) {
        for(int i=0;i<arr.length;i++){
            int minIdx=i;
            for(int j=i+1;j<arr.length;j++){
                if(arr[minIdx]>arr[j]){
                    minIdx=j;
                }
            }
            int temp=arr[i];
            arr[i]=arr[minIdx];
            arr[minIdx]=temp;
        }
    }
}
