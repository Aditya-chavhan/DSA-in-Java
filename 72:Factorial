//Que Link:https://www.geeksforgeeks.org/problems/factorial5739/1

class Solution {
    int factorial(int n) {
        if(n==0 || n==1) return 1;
        return n*factorial(n-1);
    }
}


-----------------------------------------------------------OR---------------------------------------------------------------

class Solution {
    int factorial(int n) {
        int ans=1;
        for(int i=1;i<=n;i++){
            ans=ans*i;
        }
        return ans;
    }
}
