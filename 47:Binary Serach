//Que Link:https://leetcode.com/problems/binary-search/

class Solution {
    public int search(int[] arr, int target) {
        int beg=0;
        int end=arr.length-1;
        for(int i=0;i<arr.length;i++){
            int mid=(beg+end)/2;
            if(arr[mid]==target){
                return mid;
            }
            else if(arr[mid]>target){
                end=mid-1;
            }
            else{
                beg=mid+1;
            }
        }
        return -1;
    }
}
