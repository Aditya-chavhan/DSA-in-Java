//Que Link:https://www.geeksforgeeks.org/problems/check-if-an-array-is-sorted0701/1

class Solution {
    public boolean isSorted(int[] arr) {
       boolean isSorted=true;
       for(int i=1;i<arr.length-1;i++){
           if(arr[i]<arr[i-1]){
              isSorted=false;
              break;
           }
       }
       return isSorted;
    }
}
