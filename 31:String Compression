class Solution {
    public int compress(char[] chars) {
        StringBuilder sb=new StringBuilder();
        int count=1;
        int i=1;
        while(i<chars.length){
            if(chars[i-1]==chars[i]){
                count++;
            }
            else{
                sb.append(chars[i-1]);
                if(count>1){
                    sb.append(count);
                }
                count=1;
            }
            i++;
        }
        sb.append(chars[chars.length-1]);
        if(count>1){
            sb.append(count);
        }

        for(int k=0;k<sb.length();k++){
            chars[k]=sb.charAt(k);
        }
        return sb.length();
    }
}
