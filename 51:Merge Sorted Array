//Que Link:https://leetcode.com/problems/merge-sorted-array/description/

class Solution {
    public void merge(int[] arr1, int m, int[] arr2, int n) {
        int[]ans=new int[m+n];
        mergeSort(arr1,arr2,ans,m,n);
        for(int i=0;i<ans.length;i++){
            arr1[i]=ans[i];
        }
    }
    public static void mergeSort(int[]arr1,int[]arr2,int[]ans,int m,int n){
        int i=0;int j=0;int k=0;
        while(i<m && j<n){
            if(arr1[i]<=arr2[j]){
                ans[k]=arr1[i];
                i++;
            }
            else if(arr1[i]>arr2[j]){
                ans[k]=arr2[j];
                j++;
            }
            k++;
        }

        while(i<m){
            ans[k]=arr1[i];
            i++;
            k++;
        }
        while(j<n){
            ans[k]=arr2[j];
            j++;
            k++;
        }
    }
}
